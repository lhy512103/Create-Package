  "createpackage.ponder.tag.create_package.description": "AE2 autocrafting support for Create machines and sequenced assembly",
  "createpackage.ponder.package_distributors.header": "Create Package Distributors",
  "createpackage.ponder.package_distributors.text_1": "Package Distributors hand a full AE2 processing pattern to a real Create sequenced assembly line.",
  "createpackage.ponder.package_distributors.text_2": "The route starts at an input depot or belt, visits deployers and spouts in order, and ends at the recovery position.",
  "createpackage.ponder.package_distributors.text_3": "Basic Distributors store AE2 patterns directly. Advanced Distributors read the saved route from each Mechanical Package Pattern.",
  "createpackage.ponder.kinetic_pattern_provider.header": "Kinetic Pattern Provider",
  "createpackage.ponder.kinetic_pattern_provider.text_1": "Kinetic Pattern Providers face one Create machine and supply its working position, held items, or fluids.",
  "createpackage.ponder.kinetic_pattern_provider.text_2": "Set the target side with a wrench. Add Parallel Cards and link matching machines with the Machine Linker for multi-machine dispatch.",
  "createpackage.ponder.kinetic_pattern_provider.text_3": "Saws, millstones, and crushing wheels still need a recoverable output belt, depot, or inventory at the machine output.",
  "createpackage.ponder.mechanical_route_tools.header": "Mechanical Route Tools",
  "createpackage.ponder.mechanical_route_tools.text_1": "Machine Linkers save one ordered route on a Package Distributor or Basic Package Distributor.",
  "createpackage.ponder.mechanical_route_tools.text_2": "Mechanical Pattern Converters and Mechanical Package Patterns can mark route blocks directly.",
  "createpackage.ponder.mechanical_route_tools.text_3": "Converted Mechanical Package Patterns store the original AE2 pattern plus the marked Create route for Advanced Distributors.",
  "createpackage.ponder.parallel_card.header": "Parallel Card",
  "createpackage.ponder.parallel_card.text_1": "Parallel Cards upgrade Advanced Package Distributors and Kinetic Pattern Providers.",
  "createpackage.ponder.parallel_card.text_2": "In an Advanced Distributor, one Parallel Card provides 4 concurrent jobs and two provide 8; the capacity is configurable.",
