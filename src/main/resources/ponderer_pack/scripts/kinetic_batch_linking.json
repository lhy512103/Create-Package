        {"type": "set_block", "block": "create:deployer", "blockPos": [4, 3, 1], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [4, 3, 1], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [5, 1, 1]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [5, 3, 1], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [5, 3, 1], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [6, 1, 1]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [6, 3, 1], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [6, 3, 1], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:creative_motor", "blockPos": [7, 3, 1], "blockProperties": {"facing": "west"}},
        {"type": "set_kinetic_speed", "blockPos": [3, 3, 1], "speed": 64, "blockPos2": [7, 3, 1]},
        {"type": "set_block", "block": "create:depot", "blockPos": [3, 1, 2]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [3, 3, 2], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [3, 3, 2], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [4, 1, 2]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [4, 3, 2], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [4, 3, 2], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [5, 1, 2]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [5, 3, 2], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [5, 3, 2], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [6, 1, 2]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [6, 3, 2], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [6, 3, 2], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:creative_motor", "blockPos": [7, 3, 2], "blockProperties": {"facing": "west"}},
        {"type": "set_kinetic_speed", "blockPos": [3, 3, 2], "speed": 64, "blockPos2": [7, 3, 2]},
        {"type": "set_block", "block": "create:depot", "blockPos": [3, 1, 3]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [3, 3, 3], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [3, 3, 3], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [4, 1, 3]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [4, 3, 3], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [4, 3, 3], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [5, 1, 3]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [5, 3, 3], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [5, 3, 3], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [6, 1, 3]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [6, 3, 3], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [6, 3, 3], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:creative_motor", "blockPos": [7, 3, 3], "blockProperties": {"facing": "west"}},
        {"type": "set_kinetic_speed", "blockPos": [3, 3, 3], "speed": 64, "blockPos2": [7, 3, 3]},
        {"type": "set_block", "block": "create:depot", "blockPos": [3, 1, 4]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [3, 3, 4], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [3, 3, 4], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [4, 1, 4]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [4, 3, 4], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [4, 3, 4], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [5, 1, 4]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [5, 3, 4], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [5, 3, 4], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:depot", "blockPos": [6, 1, 4]},
        {"type": "set_block", "block": "create:deployer", "blockPos": [6, 3, 4], "blockProperties": {"facing": "down", "axis_along_first": "true"}},
        {"type": "set_deployer_item", "blockPos": [6, 3, 4], "item": "create:sand_paper"},
        {"type": "set_block", "block": "create:creative_motor", "blockPos": [7, 3, 4], "blockProperties": {"facing": "west"}},
        {"type": "set_kinetic_speed", "blockPos": [3, 3, 4], "speed": 64, "blockPos2": [7, 3, 4]},
        {"type": "show_section", "blockPos": [1, 1, 1], "blockPos2": [7, 3, 4], "direction": "down"},
        {"type": "idle", "duration": 20},
        {
          "type": "text",
          "text": {
            "en_us": "This optional chapter requires FTB Ultimine. Hold the Machine Linker throughout; installing the mod does not link machines automatically.",
            "zh_cn": "本章是 FTB Ultimine 的可选联动。操作时始终手持机器链接器；只安装模组不会自动绑定机器。"
          },
          "point": [
            2.5,
            3.8,
            1.5
          ],
          "duration": 115,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true
        },
        {"type": "idle", "duration": 125},
        {"type": "show_controls", "action": "right", "point": [2.5, 3.8, 1.5], "direction": "down", "duration": 45, "item": "createpackage:machine_linker"},
        {
          "type": "text",
          "text": {
            "en_us": "First release the Ultimine key and sneak key. Right-click the provider with the linker to select the host. Its target must already face a valid Deployer.",
            "zh_cn": "先松开 Ultimine 激活键与潜行键，用链接器右键供应器，选定宿主。供应器须已设置目标面，指向有效机械手。"
          },
          "point": [
            2.5,
            3.8,
            1.5
          ],
          "duration": 115,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true
        },
        {"type": "idle", "duration": 125},
        {"type": "show_controls", "action": "scroll", "point": [4.5, 3.9, 2.5], "direction": "down", "duration": 45, "item": "createpackage:machine_linker", "whileSneaking": true},
        {
          "type": "text",
          "text": {
            "en_us": "Your Ultimine activation key is [%s]. Normally hold it with Sneak and scroll to choose a shape. If Ultimine itself is bound to Shift, its shape menu uses Ctrl instead. Check the preview and your Controls settings.",
            "zh_cn": "当前 Ultimine 激活键为 [%s]。通常按住它与潜行键，滚轮选择形状；若激活键本身设为 Shift，形状菜单改用 Ctrl。请以预览与键位设置为准。"
          },
          "point": [
            4.5,
            3.9,
            2.5
          ],
          "duration": 140,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true,
          "keybind": "key.ftbultimine"
        },
        {"type": "idle", "duration": 150},
        {"type": "highlight_section", "blockPos": [3, 3, 1], "color": "input", "duration": 110, "blockPos2": [6, 3, 4]},
        {
          "type": "text",
          "text": {
            "en_us": "Choose a shape whose preview covers the desired machines. Only loaded blocks matching the clicked block ID and the provider target type are accepted. Selection size is limited by FTB settings; use several clicks if necessary.",
            "zh_cn": "选择能覆盖目标机器的形状，以选区预览为准。只接收已加载、与点击方块注册 ID 相同且符合正面机类型的目标；FTB 选区有数量限制，不够时分批操作。"
          },
          "point": [
            4.5,
            3.9,
            2.5
          ],
          "duration": 135,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true
        },
        {"type": "idle", "duration": 145},
        {"type": "show_controls", "action": "right", "point": [4.5, 3.9, 2.5], "direction": "down", "duration": 45, "item": "createpackage:machine_linker"},
        {"type": "show_line", "point": [2.5, 3.5, 1.5], "point2": [5.5, 3.5, 3.5], "color": "input", "duration": 90},
        {
          "type": "text",
          "text": {
            "en_us": "Keep [%s] held, RELEASE Sneak, then right-click a selected machine with the linker: this adds the matching selection in one operation. Do not click the provider for this step.",
            "zh_cn": "继续按住 [%s]，松开潜行键，再手持链接器右键选区内机器：一次加入选中的同类目标。这一步点机器，不是再点供应器。"
          },
          "point": [
            4.5,
            3.9,
            2.5
          ],
          "duration": 125,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true,
          "keybind": "key.ftbultimine"
        },
        {"type": "idle", "duration": 135},
        {"type": "indicate_success", "blockPos": [2, 3, 1]},
        {"type": "show_controls", "action": "right", "point": [2.5, 3.8, 1.5], "direction": "down", "duration": 45, "item": "createpackage:parallel_card", "whileSneaking": true},
        {
          "type": "text",
          "text": {
            "en_us": "Install a Parallel Card through the upgrade slot or sneak-right-click. Links may be saved without a card, but no card uses only the front target. One card allows 16 total machines; the front target counts once.",
            "zh_cn": "通过升级槽或潜行右键装入并行卡。无卡也能保存链接，但仍只启用正面目标；一卡允许总计 16 台，正面机器只计一次。"
          },
          "point": [
            2.5,
            3.8,
            1.5
          ],
          "duration": 125,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true
        },
        {"type": "idle", "duration": 135},
        {"type": "show_controls", "action": "right", "point": [4.5, 3.9, 2.5], "direction": "down", "duration": 45, "item": "createpackage:machine_linker", "whileSneaking": true},
        {"type": "highlight_section", "blockPos": [3, 3, 1], "color": "red", "duration": 110, "blockPos2": [6, 3, 4]},
        {
          "type": "text",
          "text": {
            "en_us": "For batch removal, keep [%s] and Sneak held, then right-click a machine in the selection. This removes links, not blocks, and does not remove the provider front target.",
            "zh_cn": "批量解绑时，同时按住 [%s] 与潜行键，再右键选区内机器。它只移除链接，不拆方块，也不会取消供应器正面的默认目标。"
          },
          "point": [
            4.5,
            3.9,
            2.5
          ],
          "duration": 125,
          "color": "red",
          "placeNearTarget": false,
          "attachKeyFrame": true,
          "keybind": "key.ftbultimine"
        },
        {"type": "idle", "duration": 135},
        {"type": "show_controls", "action": "right", "point": [2.5, 3.8, 1.5], "direction": "down", "duration": 45, "item": "createpackage:machine_linker", "whileSneaking": true},
        {
          "type": "text",
          "text": {
            "en_us": "Release the Ultimine key before sneak-right-clicking the provider: that clears all saved extra links and the linker selection. For Mechanical Crafters, link one representative per independent group, not every block in a wall.",
            "zh_cn": "松开 Ultimine 激活键后，潜行右键供应器可清空全部额外链接并解除工具选择。动力合成器并行应每个独立组只选一个代表，不要把整面墙扫成多套产线。"
          },
          "point": [
            2.5,
            3.8,
            1.5
          ],
          "duration": 140,
          "color": "red",
          "placeNearTarget": false,
          "attachKeyFrame": true
        },
        {"type": "idle", "duration": 150},
        {
          "type": "text",
          "text": {
            "en_us": "This is a machine set, not an ordered assembly route. G is not used here. If no preview or batch action appears, check mod installation, the configured key, conflicts, hunger and the selected shape.",
            "zh_cn": "这里保存的是并行机器集合，不是装配顺序，不使用 G。没有预览或批量动作时，请检查模组、激活键与冲突、饥饿值，以及当前形状。"
          },
          "point": [
            2.5,
            3.8,
            1.5
          ],
          "duration": 130,
          "color": "blue",
          "placeNearTarget": false,
          "attachKeyFrame": true
        },
        {"type": "idle", "duration": 140}
      ]
    }
  ]
}
