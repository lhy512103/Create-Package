      "viewScale": 0.75,
      "steps": [
        { "type": "encapsulate_bounds", "bounds": [7, 5, 7] },
        { "type": "set_block", "block": "createpackage:basic_package_distributor", "blockPos": [1, 1, 0] },
        { "type": "create_belt", "blockPos": [0, 1, 3], "blockPos2": [5, 1, 3], "speed": -32 },
        { "type": "set_block", "block": "create:andesite_casing", "blockPos": [6, 1, 3] },
