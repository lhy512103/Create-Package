        { "type": "set_block", "block": "create:creative_motor", "blockProperties": { "facing": "east" }, "blockPos": [0, 3, 3] },
        { "type": "set_block", "block": "create:deployer", "blockProperties": { "facing": "down", "axis_along_first": "true" }, "blockPos": [1, 3, 3] },
        { "type": "set_block", "block": "create:deployer", "blockProperties": { "facing": "down", "axis_along_first": "true" }, "blockPos": [2, 3, 3] },
        { "type": "set_block", "block": "create:deployer", "blockProperties": { "facing": "down", "axis_along_first": "true" }, "blockPos": [3, 3, 3] },
        { "type": "set_block", "block": "create:deployer", "blockProperties": { "facing": "down", "axis_along_first": "true" }, "blockPos": [4, 3, 3] },
        { "type": "set_deployer_item", "blockPos": [1, 3, 3], "item": "ae2:silicon_press", "count": 1 },
        { "type": "set_deployer_item", "blockPos": [2, 3, 3], "item": "ae2:logic_processor_press", "count": 1 },
        { "type": "set_deployer_item", "blockPos": [3, 3, 3], "item": "ae2:engineering_processor_press", "count": 1 },
        { "type": "set_deployer_item", "blockPos": [4, 3, 3], "item": "ae2:calculation_processor_press", "count": 1 },
        { "type": "set_kinetic_speed", "blockPos": [0, 3, 3], "blockPos2": [4, 3, 3], "speed": 32 },
        { "type": "set_kinetic_speed", "blockPos": [0, 1, 4], "speed": -32 },
        { "type": "show_section", "direction": "down", "blockPos": [0, 1, 0], "blockPos2": [6, 3, 4] },
