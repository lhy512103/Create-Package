        { "type": "show_controls", "action": "right", "item": "createpackage:mechanical_pattern_converter", "point": [5.5, 1.9, 3.5], "direction": "down", "duration": 40 },
        { "type": "highlight_section", "blockPos": [5, 1, 3], "color": "output", "duration": 80 },
